<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/trans_add_screen_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            >

            <TextView
                android:id="@+id/transaction_add_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="@string/transaction_add"
                style="@style/AppTextTheme"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAlignment="gravity"
                android:gravity="bottom|center_horizontal"
                android:textSize="@dimen/large_text"
                android:background="?attr/colorPrimary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />


            <ImageView
                android:id="@+id/trans_add_back_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:src="@drawable/back_arrow_icon"
                style="@style/AppIconTheme"
                android:textColor="@color/white"
                android:textSize="@dimen/small_text"
                app:layout_constraintBaseline_toBaselineOf="@id/transaction_add_title"
                app:layout_constraintTop_toTopOf="@id/transaction_add_title"
                app:layout_constraintBottom_toBottomOf="@id/transaction_add_title"
                app:layout_constraintStart_toStartOf="@id/transaction_add_title"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/trans_add_tab_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:tabSelectedTextColor="@color/white"
            android:background="?attr/background"
            app:tabTextColor="?android:attr/textColor"
            app:tabRippleColor="@android:color/transparent"
            app:tabIndicator="@null"
            app:tabBackground="@drawable/add_trans_tab1"
            app:layout_constraintTop_toBottomOf="@id/transaction_add_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/income" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expense"
                />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transfer"
                />
        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                style="@style/AppTextTheme"
                android:textSize="@dimen/large_text"
                android:text="@string/date_label"
                android:textColor="@color/textSecondary"
                app:layout_constraintTop_toTopOf="@id/date_field"
                app:layout_constraintBottom_toBottomOf="@id/date_field"
                app:layout_constraintStart_toStartOf="parent"
                />
            <TextView
                android:id="@+id/date_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="50dp"
                android:maxLength="30"
                style="@style/AppSpinnerTheme"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/field_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="TextFields" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/date_icon"
                app:tint="?android:attr/textColor"
                app:layout_constraintTop_toTopOf="@id/date_field"
                app:layout_constraintBottom_toBottomOf="@id/date_field"
                app:layout_constraintEnd_toEndOf="@id/date_field"
                />

            <TextView
                android:id="@+id/amount_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                style="@style/AppTextTheme"
                android:textSize="@dimen/large_text"
                android:text="@string/amount_label"
                android:textColor="@color/textSecondary"
                app:layout_constraintTop_toTopOf="@id/amount_field"
                app:layout_constraintBottom_toBottomOf="@id/amount_field"
                app:layout_constraintStart_toStartOf="parent"
                />
            <EditText
                android:id="@+id/amount_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:maxLength="10"
                android:inputType="numberDecimal|number"
                style="@style/AppEditText"
                app:layout_constraintTop_toBottomOf="@id/date_field"
                app:layout_constraintStart_toEndOf="@id/field_barrier"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/category_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                style="@style/AppTextTheme"
                android:textSize="@dimen/large_text"
                android:text="@string/category_label"
                android:textColor="@color/textSecondary"
                app:layout_constraintTop_toTopOf="@id/category_field"
                app:layout_constraintBottom_toBottomOf="@id/category_field"
                app:layout_constraintStart_toStartOf="parent"
                />
            <Spinner
                android:id="@+id/category_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:layout_constraintTop_toBottomOf="@id/amount_field"
                app:layout_constraintStart_toEndOf="@id/field_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/account_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                style="@style/AppTextTheme"
                android:textSize="@dimen/large_text"
                android:text="@string/account_label"
                android:textColor="@color/textSecondary"
                app:layout_constraintTop_toTopOf="@id/account_field"
                app:layout_constraintBottom_toBottomOf="@id/account_field"
                app:layout_constraintStart_toStartOf="parent"
                />
            <Spinner
                android:id="@+id/account_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:layout_constraintTop_toBottomOf="@id/category_field"
                app:layout_constraintStart_toEndOf="@id/field_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/note_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                style="@style/AppTextTheme"
                android:textSize="@dimen/large_text"
                android:text="@string/note_label"
                android:textColor="@color/textSecondary"
                app:layout_constraintTop_toTopOf="@id/note_field"
                app:layout_constraintBottom_toBottomOf="@id/note_field"
                app:layout_constraintStart_toStartOf="parent"
                />
            <EditText
                android:id="@+id/note_field"
                android:layout_width="0dp"
                android:layout_margin="10dp"
                android:layout_height="wrap_content"
                android:maxLength="30"
                style="@style/AppEditText"
                app:layout_constraintTop_toBottomOf="@id/account_field"
                app:layout_constraintStart_toEndOf="@id/field_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/description_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                style="@style/AppTextTheme"
                android:textSize="@dimen/large_text"
                android:text="@string/description_label"
                android:textColor="@color/textSecondary"
                app:layout_constraintTop_toTopOf="@id/description_field"
                app:layout_constraintBottom_toBottomOf="@id/description_field"
                app:layout_constraintStart_toStartOf="parent"
                />
            <EditText
                android:id="@+id/description_field"
                android:layout_width="0dp"
                android:layout_marginVertical="50dp"
                android:layout_marginHorizontal="10dp"
                android:layout_height="wrap_content"
                android:maxLength="1000"
                style="@style/AppEditText"
                app:layout_constraintTop_toBottomOf="@id/note_field"
                app:layout_constraintStart_toEndOf="@id/field_barrier"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <Button
                android:id="@+id/delete_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/description_field"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/save_btn"
                app:layout_constraintBottom_toBottomOf="parent"
                android:visibility="gone"
                android:text="@string/delete_btn_label"
                android:textColor="@color/textPrimaryDark"
                android:backgroundTint="@color/primaryContentColor"
                />

            <Button
                android:id="@+id/save_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/description_field"
                app:layout_constraintStart_toEndOf="@id/delete_btn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="@string/save_btn_label"
                android:textColor="@color/textPrimaryDark"
                android:backgroundTint="@color/primaryContentColor"
                />


            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/field_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"
                app:constraint_referenced_ids="date_label,amount_label,category_label,account_label,note_label,description_label"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>