<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:minHeight="48dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:padding="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/trans_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/AppTextTheme"
        android:text="🍲 Food"
        android:maxLines="2"
        android:textAlignment="textStart"
        android:textSize="@dimen/small_text"
        android:textColor="@color/textSecondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/trans_account"
        app:layout_constraintHorizontal_weight="2"
        />
    <TextView
        android:id="@+id/trans_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        style="@style/AppTextTheme"
        android:text="Fast Food"
        android:visibility="visible"
        android:textAlignment="textStart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/trans_account"
        app:layout_constraintStart_toEndOf="@id/trans_category"
        app:layout_constraintEnd_toStartOf="@id/trans_amount"
        app:layout_constraintHorizontal_weight="4"
        />
    <TextView
        android:id="@+id/trans_account"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        style="@style/AppTextTheme"
        android:text="Bank"
        android:visibility="visible"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/small_text"
        android:textAlignment="textStart"
        app:layout_constraintTop_toBottomOf="@id/trans_note"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/trans_category"
        app:layout_constraintEnd_toStartOf="@id/trans_amount"
        app:layout_constraintHorizontal_weight="4"
        />
    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/trans_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/AppTextTheme"
        android:text="590"
        android:textColor="@color/textSecondary"
        android:textAlignment="textEnd"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/trans_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
