<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <TextView
        android:id="@+id/trans_info_title1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/income"
        style="@style/AppTextTheme"
        android:textSize="11sp"
        android:layout_margin="5dp"
        app:layout_constraintTop_toBottomOf="@id/trans_guideline15"
        app:layout_constraintBottom_toTopOf="@id/trans_info1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/trans_info_title2"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"/>
    <TextView
        android:id="@+id/trans_info_title2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/expense"
        style="@style/AppTextTheme"
        android:textSize="11sp"
        android:layout_margin="5dp"
        app:layout_constraintTop_toBottomOf="@id/trans_guideline15"
        app:layout_constraintBottom_toTopOf="@id/trans_info2"
        app:layout_constraintStart_toEndOf="@id/trans_info_title1"
        app:layout_constraintEnd_toStartOf="@id/trans_info_title3"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"/>
    <TextView
        android:id="@+id/trans_info_title3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/total"
        style="@style/AppTextTheme"
        android:textSize="11sp"
        android:layout_margin="5dp"
        app:layout_constraintTop_toBottomOf="@id/trans_guideline15"
        app:layout_constraintBottom_toTopOf="@id/trans_info3"
        app:layout_constraintStart_toEndOf="@id/trans_info_title2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5"/>

    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/trans_info1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/default_amount"
        style="@style/AppTextTheme"
        android:textColor="@color/secondaryContentColor"
        android:layout_margin="5dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/trans_info_title1"
        app:layout_constraintBottom_toTopOf="@id/trans_guideline25"
        app:layout_constraintStart_toStartOf="@id/trans_info_title1"
        app:layout_constraintEnd_toEndOf="@id/trans_info_title1"/>

    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/trans_info2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/default_amount"
        style="@style/AppTextTheme"
        android:textColor="@color/primaryContentColor"
        android:layout_margin="5dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/trans_info_title2"
        app:layout_constraintBottom_toTopOf="@id/trans_guideline25"
        app:layout_constraintStart_toStartOf="@id/trans_info_title2"
        app:layout_constraintEnd_toEndOf="@id/trans_info_title2"/>

    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/trans_info3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/default_amount"
        style="@style/AppTextTheme"
        android:layout_margin="5dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/trans_info_title3"
        app:layout_constraintBottom_toTopOf="@id/trans_guideline25"
        app:layout_constraintStart_toStartOf="@id/trans_info_title3"
        app:layout_constraintEnd_toEndOf="@id/trans_info_title3"/>

</merge>