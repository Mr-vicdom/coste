<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/trans_search_app_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/trans_search_guideline10"
        android:background="@color/dark_blue_600"
        >
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/trans_search_close_btn"
            style="@style/AppIconTheme"
            android:src="@drawable/close_icon"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="@id/trans_search_app_bar_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/trans_search_app_bar_title"
            />
        <TextView
            android:id="@+id/trans_search_app_bar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/search_label"
            android:textSize="@dimen/regular_text"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/trans_search_bar"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="1"
            />

        <androidx.cardview.widget.CardView
            android:id="@+id/trans_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/trans_search_app_bar_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >
            <androidx.appcompat.widget.SearchView
                android:id="@+id/trans_search_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                app:queryHint="Search with Note"
                app:iconifiedByDefault="false" />
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/trans_search_nothing_found"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:visibility="gone"
        android:text="Nothing Found"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/trans_search_guideline10"
        />

    <TextView
        android:id="@+id/trans_search_Loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:visibility="gone"
        android:text="Loading"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/trans_search_guideline10"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trans_search_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/trans_search_guideline10"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/trans_search_guideline10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.20"
        />

</androidx.constraintlayout.widget.ConstraintLayout>