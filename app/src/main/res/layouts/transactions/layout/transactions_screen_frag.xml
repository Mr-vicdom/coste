<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/trans_screen_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|snap|exitUntilCollapsed"
            app:layout_collapseMode="parallax"
            android:layout_gravity="top"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/trans_screen_search_btn"
                style="@style/AppIconTheme"
                android:src="@drawable/search_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/trans_screen_title"
                app:layout_constraintBottom_toBottomOf="@id/trans_screen_title"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/trans_screen_close_filter_btn"
                style="@style/AppIconTheme"
                android:src="@drawable/close_icon"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/trans_screen_title"
                app:layout_constraintBottom_toBottomOf="@id/trans_screen_title"/>

            <TextView
                android:id="@+id/trans_screen_title"
                style="@style/AppTextTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="10dp"
                android:text="@string/transactions"
                android:textColor="@color/white"
                android:textSize="@dimen/large_text"
                app:layout_constraintEnd_toStartOf="@+id/trans_screen_filter_btn"
                app:layout_constraintStart_toEndOf="@id/trans_screen_search_btn"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/trans_screen_month"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/trans_screen_filter_btn"
                style="@style/AppIconTheme"
                android:src="@drawable/filter_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/trans_screen_title"
                app:layout_constraintBottom_toBottomOf="@id/trans_screen_title"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/trans_previous_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/previous_arrow_icon"
                style="@style/AppIconTheme"
                app:layout_constraintTop_toTopOf="@id/trans_screen_month"
                app:layout_constraintBottom_toBottomOf="@id/trans_screen_month"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/trans_screen_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppTextTheme"
                android:text="@string/month_label"
                android:textAlignment="center"
                android:textColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/trans_screen_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/trans_next_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/next_arrow_icon"
                style="@style/AppIconTheme"
                app:layout_constraintTop_toTopOf="@id/trans_screen_month"
                app:layout_constraintBottom_toBottomOf="@id/trans_screen_month"
                app:layout_constraintEnd_toEndOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/trans_screen_view_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_collapseMode="pin"
            style="@style/TabTheme">
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weekly"
                />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monthly"
                />
        </com.google.android.material.tabs.TabLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/trans_screen_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/background"
            >
            <TextView
                android:id="@+id/trans_info_title1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/income"
                style="@style/AppTextTheme"
                android:textSize="11sp"
                android:layout_margin="5dp"
                android:paddingTop="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/trans_info1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/trans_info_title2"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread"/>
            <TextView
                android:id="@+id/trans_info_title2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:paddingTop="10dp"
                android:text="@string/expense"
                style="@style/AppTextTheme"
                android:textSize="11sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/trans_info2"
                app:layout_constraintStart_toEndOf="@id/trans_info_title1"
                app:layout_constraintEnd_toStartOf="@id/trans_info_title3"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread"/>
            <TextView
                android:id="@+id/trans_info_title3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:paddingTop="10dp"
                android:text="@string/total"
                style="@style/AppTextTheme"
                android:textSize="11sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/trans_info3"
                app:layout_constraintStart_toEndOf="@id/trans_info_title2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.5"/>

            <com.expensetracker.app.views.CurrencyTextView
                android:id="@+id/trans_info1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:paddingBottom="10dp"
                android:text="@string/default_amount"
                style="@style/AppTextTheme"
                android:textColor="@color/secondaryContentColor"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/trans_info_title1"
                app:layout_constraintStart_toStartOf="@id/trans_info_title1"
                app:layout_constraintEnd_toEndOf="@id/trans_info_title1"/>

            <com.expensetracker.app.views.CurrencyTextView
                android:id="@+id/trans_info2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:paddingBottom="10dp"
                android:text="@string/default_amount"
                style="@style/AppTextTheme"
                android:textColor="@color/primaryContentColor"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/trans_info_title2"
                app:layout_constraintStart_toStartOf="@id/trans_info_title2"
                app:layout_constraintEnd_toEndOf="@id/trans_info_title2"/>

            <com.expensetracker.app.views.CurrencyTextView
                android:id="@+id/trans_info3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:paddingBottom="10dp"
                android:text="@string/default_amount"
                style="@style/AppTextTheme"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/trans_info_title3"
                app:layout_constraintStart_toStartOf="@id/trans_info_title3"
                app:layout_constraintEnd_toEndOf="@id/trans_info_title3"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>


    <ScrollView
        android:id="@+id/trans_screen_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/background"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            >
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trans_screen_list_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="120dp"
                app:layout_constraintTop_toTopOf="parent"
                />
            <TextView
                android:id="@+id/trans_screen_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:visibility="visible"
                android:text="Loading.."
                android:textColor="@color/textSecondary"
                android:textStyle="bold"
                android:textSize="@dimen/large_text"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:id="@+id/trans_screen_nothing_found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:visibility="gone"
                android:text="Nothing Found!"
                android:textColor="@color/textSecondary"
                android:textStyle="bold"
                android:textSize="@dimen/large_text"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:src="@drawable/plus_icon"
        android:scaleType="centerCrop"
        style="@style/AppIconTheme"
        app:layout_anchor="@id/trans_screen_scroll_view"
        app:layout_anchorGravity="bottom|end"
        app:layout_dodgeInsetEdges="bottom"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"
        />

</androidx.coordinatorlayout.widget.CoordinatorLayout>