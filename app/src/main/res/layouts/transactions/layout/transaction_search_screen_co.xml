<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/trans_screen_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_blue_600"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/trans_search_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/trans_search_guideline10"
            android:background="@color/dark_blue_600"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/trans_search_close_btn"
                style="@style/AppIconTheme"
                android:src="@drawable/close_icon"
                android:scaleType="fitCenter"
                app:layout_constraintTop_toTopOf="@id/trans_search_app_bar_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/trans_search_app_bar_title"
                />
            <TextView
                android:id="@+id/trans_search_app_bar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/search_label"
                android:textSize="@dimen/regular_text"
                android:textColor="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/trans_search_bar"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="1"
                />

            <androidx.cardview.widget.CardView
                android:id="@+id/trans_search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardCornerRadius="10dp"
                app:layout_constraintTop_toBottomOf="@id/trans_search_app_bar_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >
                <androidx.appcompat.widget.SearchView
                    android:id="@+id/trans_search_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    app:queryHint="Search with Note"
                    app:iconifiedByDefault="false" />
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/background"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/trans_search_nothing_found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:visibility="gone"
                android:text="Nothing found!"
                android:textColor="@color/textSecondary"
                android:textStyle="bold"
                android:textSize="@dimen/large_text"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@id/trans_search_guideline10"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <TextView
                android:id="@+id/trans_search_Loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:visibility="gone"
                android:text="Loading.."
                android:textColor="@color/textSecondary"
                android:textStyle="bold"
                android:textSize="@dimen/large_text"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@id/trans_search_guideline10"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trans_search_result"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/trans_search_guideline10"
                app:layout_constraintBottom_toBottomOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>