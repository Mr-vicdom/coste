<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    android:theme="@style/NewAppTheme.DarkBlueStatusBar"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/trans_filter_app_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/trans_filter_text_box"
        android:background="@color/dark_blue_600"
        >
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/trans_filter_close_btn"
            style="@style/AppIconTheme"
            android:src="@drawable/close_icon"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <TextView
            android:id="@+id/trans_filter_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="@string/month_label"
            android:maxLength="3"
            android:textSize="@dimen/regular_text"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/trans_filter_text_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/dark_blue_800"
        app:layout_constraintTop_toBottomOf="@id/trans_filter_app_bar"
        app:layout_constraintBottom_toTopOf="@id/trans_filter_guideline10"
        >
        <TextView
            android:id="@+id/trans_filter_label_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="10dp"
            android:text="@string/select_the_filter_to_apply"
            android:textColor="@color/white"
            android:textSize="@dimen/regular_text"
            android:textAlignment="viewStart"
            android:gravity="center_vertical|start"
            style="@style/AppTextTheme"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <Button
            android:id="@+id/trans_filter_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/filter_btn_label"
            android:textAllCaps="false"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            android:textSize="@dimen/small_text"
            app:layout_constraintTop_toTopOf="@id/trans_filter_label_text"
            app:layout_constraintBottom_toBottomOf="@id/trans_filter_label_text"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>



    <TextView
        android:id="@+id/trans_filter_info_title1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/income"
        style="@style/AppTextTheme"
        android:textSize="11sp"
        android:layout_margin="5dp"
        app:layout_constraintTop_toBottomOf="@id/trans_filter_guideline10"
        app:layout_constraintBottom_toTopOf="@id/trans_filter_info1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/trans_filter_info_title2"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"/>
    <TextView
        android:id="@+id/trans_filter_info_title2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/expense"
        style="@style/AppTextTheme"
        android:textSize="11sp"
        android:layout_margin="5dp"
        app:layout_constraintTop_toBottomOf="@id/trans_filter_guideline10"
        app:layout_constraintBottom_toTopOf="@id/trans_filter_info2"
        app:layout_constraintStart_toEndOf="@id/trans_filter_info_title1"
        app:layout_constraintEnd_toStartOf="@id/trans_filter_info_title3"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"/>
    <TextView
        android:id="@+id/trans_filter_info_title3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/total"
        style="@style/AppTextTheme"
        android:textSize="11sp"
        android:layout_margin="5dp"
        app:layout_constraintTop_toBottomOf="@id/trans_filter_guideline10"
        app:layout_constraintBottom_toTopOf="@id/trans_filter_info3"
        app:layout_constraintStart_toEndOf="@id/trans_filter_info_title2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5"/>

    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/trans_filter_info1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/default_amount"
        style="@style/AppTextTheme"
        android:textColor="@color/secondaryContentColor"
        android:layout_margin="5dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/trans_filter_info_title1"
        app:layout_constraintBottom_toTopOf="@id/trans_filter_guideline25"
        app:layout_constraintStart_toStartOf="@id/trans_filter_info_title1"
        app:layout_constraintEnd_toEndOf="@id/trans_filter_info_title1"/>

    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/trans_filter_info2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/default_amount"
        style="@style/AppTextTheme"
        android:textColor="@color/primaryContentColor"
        android:layout_margin="5dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/trans_filter_info_title2"
        app:layout_constraintBottom_toTopOf="@id/trans_filter_guideline25"
        app:layout_constraintStart_toStartOf="@id/trans_filter_info_title2"
        app:layout_constraintEnd_toEndOf="@id/trans_filter_info_title2"/>

    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/trans_filter_info3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/default_amount"
        style="@style/AppTextTheme"
        android:layout_margin="5dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/trans_filter_info_title3"
        app:layout_constraintBottom_toTopOf="@id/trans_filter_guideline25"
        app:layout_constraintStart_toStartOf="@id/trans_filter_info_title3"
        app:layout_constraintEnd_toEndOf="@id/trans_filter_info_title3"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trans_filter_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/trans_filter_guideline25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        />


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/trans_filter_guideline10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/trans_filter_guideline25"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.25"
        />
</androidx.constraintlayout.widget.ConstraintLayout>