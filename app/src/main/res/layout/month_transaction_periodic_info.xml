<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/period_space_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:background="?attr/cardBackgroundColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <View
            style="@style/MildBorder"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints" />
        <View
            style="@style/MildBorder"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:ignore="MissingConstraints" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/period_space_bar">

        <TextView
            android:id="@+id/month_trans_period_info_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            style="@style/AppTextTheme"
            android:text="Sep"
            android:textSize="@dimen/large_text"
            android:textStyle="bold"
            android:maxLength="3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_bias="0.1"
            />

        <TextView
            android:id="@+id/month_trans_period_info_start_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            style="@style/AppTextTheme"
            android:text="22"
            android:textSize="@dimen/small_text"
            android:textStyle="normal"
            android:maxLength="2"
            app:layout_constraintTop_toBottomOf="@id/month_trans_period_info_month"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/month_trans_period_info_month"
            app:layout_constraintEnd_toStartOf="@id/month_trans_period_info_end_date"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLength="1"
            android:layout_marginHorizontal="10dp"
            android:text="~"
            android:textStyle="normal"
            android:textSize="@dimen/small_text"
            app:layout_constraintTop_toTopOf="@id/month_trans_period_info_start_date"
            app:layout_constraintBottom_toBottomOf="@id/month_trans_period_info_start_date"
            app:layout_constraintStart_toEndOf="@id/month_trans_period_info_start_date"
            app:layout_constraintEnd_toStartOf="@id/month_trans_period_info_end_date"/>

        <TextView
            android:id="@+id/month_trans_period_info_end_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            style="@style/AppTextTheme"
            android:text="22"
            android:textSize="@dimen/small_text"
            android:textStyle="normal"
            android:maxLength="2"
            app:layout_constraintTop_toBottomOf="@id/month_trans_period_info_month"
            app:layout_constraintBottom_toBottomOf="@id/month_trans_period_info_start_date"
            app:layout_constraintStart_toEndOf="@id/month_trans_period_info_start_date"
            app:layout_constraintEnd_toEndOf="@id/month_trans_period_info_month"
            app:layout_constraintBaseline_toBaselineOf="@id/month_trans_period_info_start_date"
            />




        <com.expensetracker.app.views.CurrencyTextView
            android:id="@+id/month_trans_periodic_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:textAlignment="textEnd"
            style="@style/AppTextTheme"
            android:text="@string/default_amount"
            android:textColor="@color/secondaryContentColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/month_trans_periodic_info_guideline50"
            app:layout_constraintEnd_toStartOf="@id/month_trans_periodic_expense"
            app:layout_constraintVertical_bias="0.1"
            />


        <com.expensetracker.app.views.CurrencyTextView
            android:id="@+id/month_trans_periodic_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:textAlignment="textEnd"
            style="@style/AppTextTheme"
            android:text="@string/default_amount"
            app:layout_constraintBaseline_toBaselineOf="@id/month_trans_periodic_income"
            android:textColor="@color/primaryContentColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/month_trans_periodic_total"
            app:layout_constraintStart_toEndOf="@id/month_trans_periodic_income"
            app:layout_constraintEnd_toEndOf="parent"
            />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:textAlignment="textEnd"
            style="@style/AppTextTheme"
            android:textSize="@dimen/small_text"
            android:text="@string/total"
            android:textColor="@color/textSecondary"
            app:layout_constraintTop_toTopOf="@id/month_trans_periodic_total"
            app:layout_constraintBottom_toBottomOf="@id/month_trans_periodic_total"
            app:layout_constraintEnd_toStartOf="@id/month_trans_periodic_total"
            />

        <com.expensetracker.app.views.CurrencyTextView
            android:id="@+id/month_trans_periodic_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:textAlignment="textEnd"
            style="@style/AppTextTheme"
            android:textSize="@dimen/small_text"
            android:text="@string/default_amount"
            android:textColor="@color/textSecondary"
            app:layout_constraintTop_toBottomOf="@id/month_trans_periodic_expense"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/month_trans_periodic_expense"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/month_trans_periodic_info_guideline50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5"/>

        <View
            style="@style/MildBorder"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:ignore="MissingConstraints" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>