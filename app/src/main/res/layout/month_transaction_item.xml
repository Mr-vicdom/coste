<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/cardBackgroundColor"
    android:foreground="?attr/selectableItemBackground"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/week_trans_period_info_start_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        style="@style/AppTextTheme"
        android:text="22"
        android:textSize="@dimen/regular_text"
        android:textStyle="normal"
        android:maxLength="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/week_trans_period_info_end_date"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_bias="0.1"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLength="1"
        android:layout_marginHorizontal="10dp"
        android:text="~"
        app:layout_constraintTop_toTopOf="@id/week_trans_period_info_start_date"
        app:layout_constraintBottom_toBottomOf="@id/week_trans_period_info_start_date"
        app:layout_constraintStart_toEndOf="@id/week_trans_period_info_start_date"
        app:layout_constraintEnd_toStartOf="@id/week_trans_period_info_end_date"/>

    <TextView
        android:id="@+id/week_trans_period_info_end_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        style="@style/AppTextTheme"
        android:text="22"
        android:textSize="@dimen/regular_text"
        android:textStyle="normal"
        android:maxLength="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/week_trans_period_info_start_date"
        app:layout_constraintEnd_toStartOf="@id/week_trans_periodic_info_guideline50"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_bias="0.1"
        />

    <TextView
        android:id="@+id/week_trans_week_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="5dp"
        style="@style/AppTextTheme"
        android:textAllCaps="true"
        android:text="week"
        android:textColor="@color/textSecondary"
        android:background="@android:color/transparent"
        android:textSize="@dimen/small_text"
        android:maxLength="6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/week_trans_period_info_end_date"
        app:layout_constraintEnd_toStartOf="@id/week_trans_periodic_info_guideline50"
        />
    <TextView
        android:id="@+id/week_trans_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingHorizontal="5dp"
        style="@style/AppTextTheme"
        android:textAllCaps="true"
        android:text="1"
        android:textColor="@color/textSecondary"
        android:background="@android:color/transparent"
        android:textSize="@dimen/small_text"
        android:maxLength="6"
        app:layout_constraintTop_toTopOf="@id/week_trans_week_text"
        app:layout_constraintBottom_toBottomOf="@id/week_trans_week_text"
        app:layout_constraintStart_toEndOf="@id/week_trans_week_text"/>

    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/week_trans_income"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:textAlignment="textEnd"
        style="@style/AppTextTheme"
        android:text="@string/default_amount"
        android:textColor="@color/secondaryContentColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/week_trans_periodic_info_guideline50"
        app:layout_constraintEnd_toStartOf="@id/week_trans_expense"
        app:layout_constraintVertical_bias="0.1"
        />


    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/week_trans_expense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:textAlignment="textEnd"
        style="@style/AppTextTheme"
        android:text="@string/default_amount"
        app:layout_constraintBaseline_toBaselineOf="@id/week_trans_income"
        android:textColor="@color/primaryContentColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/week_trans_total"
        app:layout_constraintStart_toEndOf="@id/week_trans_income"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <com.expensetracker.app.views.CurrencyTextView
        android:id="@+id/week_trans_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:textAlignment="textEnd"
        style="@style/AppTextTheme"
        android:textSize="@dimen/small_text"
        android:text="@string/default_amount"
        android:textColor="@color/textSecondary"
        app:layout_constraintTop_toBottomOf="@id/week_trans_expense"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/week_trans_expense"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/week_trans_periodic_info_guideline50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"/>

    <View
        style="@style/MildBorder"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints" />


</androidx.constraintlayout.widget.ConstraintLayout>