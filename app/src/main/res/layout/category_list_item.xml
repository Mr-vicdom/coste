<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:background="?attr/selectableItemBackground"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/remove_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:contentPadding="20dp"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="10dp"
        android:backgroundTint="@color/transparent"
        app:cardElevation="0dp"
        app:cardCornerRadius="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/field_text"
        app:layout_constraintHorizontal_weight="1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/remove_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/white"
            android:scaleType="center"
            android:background="@color/red"/>

    </androidx.cardview.widget.CardView>

    <EditText
        android:id="@+id/field_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="5dp"
        android:textAlignment="viewStart"
        style="@style/AppTextTheme"
        android:text="@string/account"
        android:textSize="@dimen/large_text"
        android:maxLines="1"
        android:maxLength="30"
        android:textStyle="normal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/edit_category_discard_btn"
        app:layout_constraintStart_toEndOf="@id/remove_icon"
        app:layout_constraintHorizontal_weight="2"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_category_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/edit_icon"
        android:visibility="visible"
        style="@style/AppIconTheme"
        app:tint="@color/textSecondary"
        app:layout_constraintTop_toTopOf="@id/field_text"
        app:layout_constraintBottom_toBottomOf="@id/field_text"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_category_discard_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/close_icon"
        android:visibility="gone"
        style="@style/AppIconTheme"
        app:tint="@color/primaryContentColor"
        app:layout_constraintTop_toTopOf="@id/field_text"
        app:layout_constraintBottom_toBottomOf="@id/field_text"
        app:layout_constraintEnd_toStartOf="@id/edit_category_done_btn"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_category_done_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/done_icon"
        android:visibility="gone"
        style="@style/AppIconTheme"
        app:tint="@color/secondaryContentColor"
        app:layout_constraintTop_toTopOf="@id/edit_category_discard_btn"
        app:layout_constraintBottom_toBottomOf="@id/edit_category_discard_btn"
        app:layout_constraintEnd_toEndOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>